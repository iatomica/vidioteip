{
  "name": "vidioteip",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.525",
    "@remotion/tailwind-v4": "4.0.525",
    "lucide-react": "^1.46.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.525",
    "tailwindcss": "4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.525",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render BarilocheVertical out/bariloche-summary.mp4",
    "render:vertical": "remotion render BarilocheVertical out/bariloche-summary.mp4",
    "render:horizontal": "remotion render BarilocheHorizontal out/bariloche-summary-horizontal.mp4",
    "engine:status": "tsx src/engine/cli.ts status",
    "engine:scrape": "tsx src/engine/cli.ts scrape",
    "engine:produce": "tsx src/engine/cli.ts produce",
    "engine:run": "tsx src/engine/cli.ts run",
    "engine:clean": "tsx src/engine/cli.ts clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\""
  },
  "sideEffects": [
    "*.css"
  ]
}
